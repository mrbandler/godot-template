@tool
extends VBoxContainer

const ReferenceScanner = preload("res://addons/broken_reference_finder/reference_scanner.gd")

var editor_interface: EditorInterface
var _results: Array = []

@onready var _toolbar: HBoxContainer = $Toolbar
@onready var _status_label: Label = $StatusLabel
@onready var _list: ItemList = $ResultList

func _ready() -> void:
	_toolbar.get_node("ScanButton").pressed.connect(_on_scan_pressed)
	_toolbar.get_node("ExportButton").pressed.connect(_on_export_pressed)
	_toolbar.get_node("ExportButton").disabled = true
	_list.item_activated.connect(_on_item_activated)
	_status_label.text = "Click Scan to look for broken res:// references."

func _on_scan_pressed() -> void:
	_status_label.text = "Scanning..."
	_list.clear()
	var scanner := ReferenceScanner.new()
	_results = scanner.scan("res://")
	for entry in _results:
		_list.add_item("%s:%d  ->  %s" % [entry["referenced_from"], entry["line"], entry["target"]])
	if _results.is_empty():
		_status_label.text = "No broken references found. Nice and tidy."
	else:
		_status_label.text = "%d broken reference(s) found. Review before fixing." % _results.size()
	_toolbar.get_node("ExportButton").disabled = _results.is_empty()

func _on_item_activated(index: int) -> void:
	if index < 0 or index >= _results.size():
		return
	var path: String = _results[index]["referenced_from"]
	var abs_path := ProjectSettings.globalize_path(path)
	OS.shell_show_in_file_manager(abs_path)

func _on_export_pressed() -> void:
	var out_path := "res://broken_references.md"
	var file := FileAccess.open(out_path, FileAccess.WRITE)
	if file == null:
		push_error("Broken Reference Finder: could not write %s" % out_path)
		return
	file.store_line("# Broken references")
	file.store_line("")
	file.store_line("Generated by Broken Reference Finder — %d broken reference(s). Review each one before fixing." % _results.size())
	file.store_line("")
	for entry in _results:
		file.store_line("- `%s` line %d points to missing `%s`" % [entry["referenced_from"], entry["line"], entry["target"]])
	file.close()
	_status_label.text = "Exported to broken_references.md"
	if editor_interface:
		var fs := editor_interface.get_resource_filesystem()
		if fs:
			fs.scan()
