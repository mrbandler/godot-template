@tool
extends VBoxContainer

const TodoScanner = preload("res://addons/todo_tracker/todo_scanner.gd")

const TYPE_COLORS := {
	"TODO": Color("4fc3f7"),
	"FIXME": Color("ff8a65"),
	"HACK": Color("ba68c8"),
	"BUG": Color("e57373"),
	"NOTE": Color("aed581"),
}

var editor_interface: EditorInterface
var _scanner := TodoScanner.new()
var _all_results: Array = []
var _active_filters: Dictionary = {}
var _custom_colors: Dictionary = {}

@onready var _tree: Tree = $Tree
@onready var _status_label: Label = $Toolbar/StatusLabel
@onready var _toolbar: HBoxContainer = $Toolbar
@onready var _filter_bar: HBoxContainer = $FilterBar
@onready var _custom_tag_name: LineEdit = $CustomTagBar/CustomTagName
@onready var _custom_tag_pattern: LineEdit = $CustomTagBar/CustomTagPattern
@onready var _add_custom_tag_button: Button = $CustomTagBar/AddCustomTagButton

func _ready() -> void:
	for tag in TYPE_COLORS.keys():
		_active_filters[tag] = true
	_build_ui()
	refresh()

func _tag_color(tag: String) -> Color:
	if TYPE_COLORS.has(tag):
		return TYPE_COLORS[tag]
	if not _custom_colors.has(tag):
		# Stable, readable color derived from the tag name so each custom
		# tag keeps the same color across sessions without being stored.
		var h: float = float(abs(tag.hash()) % 1000) / 1000.0
		_custom_colors[tag] = Color.from_hsv(h, 0.55, 0.95)
	return _custom_colors[tag]

func _build_ui() -> void:
	# Toolbar
	_toolbar.get_node("RefreshButton").pressed.connect(refresh)
	_toolbar.get_node("ExportButton").pressed.connect(_export_markdown)
	_add_custom_tag_button.pressed.connect(_on_add_custom_tag_pressed)

	_rebuild_filter_bar()

	_tree.columns = 4
	_tree.set_column_title(0, "Type")
	_tree.set_column_title(1, "Note")
	_tree.set_column_title(2, "File")
	_tree.set_column_title(3, "Line")
	_tree.column_titles_visible = true
	_tree.set_column_expand(0, false)
	_tree.set_column_custom_minimum_width(0, 70)
	_tree.set_column_expand(3, false)
	_tree.set_column_custom_minimum_width(3, 50)
	_tree.item_activated.connect(_on_item_activated)

func _all_tag_names() -> Array:
	return TYPE_COLORS.keys() + _scanner.get_custom_tag_names()

func _rebuild_filter_bar() -> void:
	for child in _filter_bar.get_children():
		child.queue_free()
	for tag in _all_tag_names():
		if not _active_filters.has(tag):
			_active_filters[tag] = true
		var btn := CheckButton.new()
		btn.text = tag
		btn.button_pressed = _active_filters[tag]
		btn.add_theme_color_override("font_color", _tag_color(tag))
		btn.toggled.connect(func(pressed): _on_filter_toggled(tag, pressed))
		_filter_bar.add_child(btn)

func _on_add_custom_tag_pressed() -> void:
	var name_text := _custom_tag_name.text
	var pattern_text := _custom_tag_pattern.text
	if _scanner.add_custom_tag(name_text, pattern_text):
		_custom_tag_name.text = ""
		_custom_tag_pattern.text = ""
		_rebuild_filter_bar()
		refresh()
	else:
		_status_label.text = "Tag name must be new and non-empty."

func refresh() -> void:
	_all_results = _scanner.scan()
	_populate_tree()

func _on_filter_toggled(tag: String, pressed: bool) -> void:
	_active_filters[tag] = pressed
	_populate_tree()

func _populate_tree() -> void:
	_tree.clear()
	var root := _tree.create_item()
	_tree.hide_root = true
	var counts := {}
	for item in _all_results:
		var tag: String = item["type"]
		if not _active_filters.get(tag, true):
			continue
		counts[tag] = counts.get(tag, 0) + 1
		var row := _tree.create_item(root)
		row.set_text(0, tag)
		row.set_custom_color(0, _tag_color(tag))
		row.set_text(1, item["text"])
		row.set_text(2, item["file"].replace("res://", ""))
		row.set_text(3, str(item["line"]))
		row.set_metadata(0, item)

	var total := 0
	var parts := PackedStringArray()
	for tag in _all_tag_names():
		var c: int = counts.get(tag, 0)
		total += c
		if c > 0:
			parts.append("%s: %d" % [tag, c])
	if total == 0:
		_status_label.text = "No TODOs found. Nice and tidy!"
	else:
		_status_label.text = "%d found — %s" % [total, ", ".join(parts)]

func _on_item_activated() -> void:
	var selected := _tree.get_selected()
	if selected == null:
		return
	var item: Dictionary = selected.get_metadata(0)
	if item.is_empty() or editor_interface == null:
		return
	var script := load(item["file"])
	if script is Script:
		editor_interface.edit_script(script, item["line"] - 1, 0)
	elif script is Resource:
		editor_interface.edit_resource(script)

func _export_markdown() -> void:
	var path := "res://todo_report.md"
	var file := FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		push_error("Todo Tracker: could not write %s" % path)
		return
	file.store_line("# Todo Report")
	file.store_line("")
	file.store_line("Generated by Todo Tracker — %d items." % _all_results.size())
	file.store_line("")
	for tag in _all_tag_names():
		var items := _all_results.filter(func(i): return i["type"] == tag)
		if items.is_empty():
			continue
		file.store_line("## %s (%d)" % [tag, items.size()])
		file.store_line("")
		for item in items:
			var file_path: String = item["file"].replace("res://", "")
			file.store_line("- [ ] `%s:%d` — %s" % [file_path, item["line"], item["text"]])
		file.store_line("")
	file.close()
	_status_label.text = "Exported to todo_report.md"
	var fs := editor_interface.get_resource_filesystem()
	if fs:
		fs.scan()
