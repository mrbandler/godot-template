# Line endings: normalise text to LF everywhere.
* text=auto eol=lf

# Git LFS for binary and raw assets. Text formats (.tscn, .tres, .gd, .import, .godot,
# .cfg, .svg, .gltf, .ptex, .tmx, .ldtk, .rpp) stay in plain git so they diff and merge.
[attr]lfs filter=lfs diff=lfs merge=lfs -text

